// Waybar — the toolbox section. A second, separate waybar process
// (waybar-toolbox.service) that holds game mode, night light, Keep awake,
// the shortcuts button and the tray. It starts hidden and drops down under the
// sliders pill on the main bar (custom/toolbox in ./config) when that pill is
// clicked; clicking it again folds it away. scripts/toolbox.sh does the toggle.
// While the dock or the taskbar runs (hypr/scripts/dock.py) that pill is
// hidden and their own toolbox button opens it instead: then it is a bottom
// bar, the card coming up next to that button (scripts/toolbox_fit.py has
// where exactly, for a bottom, left or right dock).
//
// Why a waybar and not a panel.py card like the others: the tray. A tray needs
// a StatusNotifierWatcher that is up for the whole session -- apps register
// with it once, at start, and some decide there is no tray at all if nobody
// answers -- and it needs the apps' own right-click menus. waybar's tray
// module already does both; a short-lived GTK panel could do neither.
//
// A horizontal (top) bar, although the card is a column: waybar's tray lays
// its icons out along the BAR's orientation and ignores a group's, so this is
// the only way to get the tray icons side by side in a row instead of stacked.
// The rows are stacked by group/card ("orientation": "vertical") instead.
//
// Layer-shell has no "anchor to one corner only" for a waybar: a top bar is
// always anchored top + left + right, and stretched between its margins; its
// height follows the content. So the margins ARE the width of the box: 4 from
// the top (measured from under the main bar, whose 36 px Hyprland already
// reserves), 58 from the right (the power pill, so the card lines up under the
// sliders pill), and from the left whatever makes the box exactly as wide as
// the card. That only moves once the tray row outgrows the other rows, but it
// lives in generated/ and is rewritten by scripts/toolbox_fit.py each time the
// section opens: any transparent box left beside the card would swallow clicks
// meant to close it. The same goes for a bottom bar (at the dock), anchored
// bottom + left + right.
//
// No "position" here on purpose: it comes from that generated include too
// ("top" or "bottom", toolbox_fit.py), and waybar takes from an include only
// the keys this file lacks. Without the include waybar's default is "top".
[
{
    "name": "waybar-toolbox",
    "layer": "overlay",
    "exclusive": false,
    "start_hidden": true,
    "include": ["~/.config/waybar/generated/toolbox-margin.jsonc"],
    "reload_style_on_change": true,

    "modules-left": ["group/card"],

    "group/card": {
        "orientation": "vertical",
        "modules": [
            "custom/settings",
            "custom/fsstate",
            "custom/nightlight",
            "custom/awake",
            // The microphone and battery rows: shown by bar-settings.py while
            // the top bar is off (toolbox-config-path); show them here to keep
            // them for good.
            // hidden: "custom/keybinds#mic",
            // hidden: "custom/keybinds#battery",
            "custom/display",
            "custom/keybinds",
            "tray"
        ]
    },

    // Split fullscreen state. Hyprland tracks what it does to a window and
    // what the window is told separately; this toggles the two useful
    // mismatches. Left: the app thinks it is fullscreen but stays a normal
    // window. Right: the window fills the monitor but the app thinks it is
    // windowed (borderless). Middle: back to plain windowed.
    //
    // No "interval": the script watches Hyprland's event socket and re-reads
    // state on a short timer, because a mode-A change never fires a
    // `fullscreen` event -- the internal state it keys off of does not move.
    "custom/fsstate": {
        "tooltip": false,
        "exec": "$HOME/.config/waybar/scripts/fsstate.py watch",
        "return-type": "json",
        "restart-interval": 5,
        "format": "{}   Game mode",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "on-click": "$HOME/.config/waybar/scripts/fsstate.py a",
        "on-click-right": "$HOME/.config/waybar/scripts/fsstate.py b",
        "on-click-middle": "$HOME/.config/waybar/scripts/fsstate.py reset"
    },

    // Night light button. All logic is in ~/.config/hypr/scripts/nightlight.sh;
    // click = same as SUPER+N (flip until the next 20:00/07:00 boundary, then
    // the schedule takes over again). The script signals this row (11,
    // bar_signals.py "nightlight") whenever it changes the screen, and
    // toolbox.sh does each time the card opens, so it needs no interval: it
    // used to re-run every 60 s while folded away. An override lapsing shows
    // when the 5-minute tick applies it -- when the screen itself changes.
    // class on/off drives the colour.
    "custom/nightlight": {
        "tooltip": false,
        "exec": "$HOME/.config/hypr/scripts/nightlight.sh status --json",
        "return-type": "json",
        "interval": "once",
        "signal": 11,
        "format": "{icon}   Night light",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "format-icons": { "on": "", "off": "" },
        "on-click": "$HOME/.config/hypr/scripts/nightlight.sh toggle"
    },

    // Keep awake: the same switch as Settings > Power (idle-settings.py
    // awake, a systemd idle lock hypridle honours), so the two always agree.
    // This used to be waybar's built-in idle_inhibitor, a Wayland inhibitor
    // only this waybar knew about -- a second "Keep awake" the Power page
    // could not see. scripts/toolbox_awake.py has the details. Left: on until
    // turned off / off. Right: on for an hour. Signal 21: after a click,
    // from toolbox.sh each time the card opens, and from a one-off timer
    // toolbox_awake.py books for when an hour's Keep awake runs out -- so no
    // interval (it used to run every 60 s, card open or not).
    "custom/awake": {
        "tooltip": false,
        "exec": "$HOME/.config/waybar/scripts/toolbox_awake.py",
        "return-type": "json",
        "interval": "once",
        "signal": 21,
        "format": "{icon}   {text}",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "format-icons": { "activated": "\uf0f4", "deactivated": "\uf186" },
        "on-click": "$HOME/.config/waybar/scripts/toolbox_awake.py toggle",
        "on-click-right": "$HOME/.config/waybar/scripts/toolbox_awake.py toggle 60"
    },

    // Microphone: the default input's level, muted or not, lit while an app
    // listens (scripts/mic_row.py; the bar's mic pill says only "in use").
    // Left: mute / unmute. Wheel: 5 % louder / quieter. Right: the input
    // devices in pavucontrol. Event-driven (pactl subscribe), no interval.
    // Named keybinds#mic on purpose: waybar gives a "module#name" the
    // module's CSS id (#custom-keybinds) and the name as a class (.mic), so
    // every theme styles it as the plain row it is -- a new id would get no
    // row look at all, and the bar's Font Awesome fallback would draw the
    // word "Microphone" as its ligature, the mic icon.
    "custom/keybinds#mic": {
        "exec": "$HOME/.config/waybar/scripts/mic_row.py watch",
        "return-type": "json",
        "restart-interval": 5,
        "format": "{}",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "on-click-right": "$HOME/.config/waybar/scripts/toolbox.sh hide; pavucontrol -t 4"
    },

    // The Battery row: the charge and the time left (or to full), from
    // UPower (scripts/battery_row.py says how). No text without a battery,
    // so waybar hides the row there. Click: Settings > Power & lock. Named
    // keybinds#battery for the plain row's look, as keybinds#mic above.
    "custom/keybinds#battery": {
        "exec": "$HOME/.config/waybar/scripts/battery_row.py",
        "return-type": "json",
        "interval": 30,
        "format": "{}",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "on-click": "$HOME/.config/waybar/scripts/toolbox.sh hide; $HOME/.config/hypr/scripts/settings.py power"
    },

    // Display: HDR, screen filter, animation preset, wallpaper theme -- the
    // display panel (scripts/display_panel.py), same as SUPER+ALT+D. Lit
    // while a screen filter is on. Right: filter on/off (= SUPER+SHIFT+F).
    // ~/.config/hypr/scripts/display.py signals 13 after every change.
    // The word has a zero-width non-joiner between its letters: "display"
    // (and "play") are Font Awesome icon names, and in a theme whose font
    // stack reaches Font Awesome first its ligature drew the word as the
    // icon (scripts/mic_row.py has the same for "Microphone").
    "custom/display": {
        "tooltip": false,
        "exec": "$HOME/.config/hypr/scripts/display.py bar",
        "return-type": "json",
        "interval": "once",
        "signal": 13,
        "format": "{}   D\u200ci\u200cs\u200cp\u200cl\u200ca\u200cy",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "on-click": "$HOME/.config/waybar/scripts/toolbox.sh hide; $HOME/.config/waybar/scripts/panel.py toggle display",
        "on-click-right": "$HOME/.config/hypr/scripts/display.py filter toggle"
    },

    // Opens the shortcuts panel (scripts/keybinds_panel.py), same as SUPER+F1,
    // and folds this section away so the two do not stack.
    // Static text from exec: waybar hides a custom module whose exec prints nothing.
    "custom/keybinds": {
        "tooltip": false,
        "exec": "echo '{\"text\": \"\", \"tooltip\": \"Keyboard shortcuts  (Super+F1)\"}'",
        "return-type": "json",
        "interval": "once",
        "format": "{}   Shortcuts",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "on-click": "$HOME/.config/waybar/scripts/toolbox.sh hide; $HOME/.config/waybar/scripts/panel.py toggle keybinds"
    },

    // Opens the Settings window (hypr/scripts/settings.py), same as SUPER+I:
    // screens, theme, emergency alerts, devices, system. Folds this away.
    "custom/settings": {
        "tooltip": false,
        "exec": "echo '{\"text\": \"\uf013\", \"tooltip\": \"Settings  (Super+I)\"}'",
        "return-type": "json",
        "interval": "once",
        "format": "{}   Settings",
        "align": 0,
        "expand": true,         // the two tiles of a grid line share its width
        "on-click": "$HOME/.config/waybar/scripts/toolbox.sh hide; $HOME/.config/hypr/scripts/settings.py"
    },

    // Background apps. Horizontal row of icons at the bottom of the card.
    "tray": {
        "tooltip": false,
        "icon-size": 18,
        "spacing": 10
    }
}
]
