+// CMonitor::updateMatrix() is private, but the projection it caches has to be
+// recomputed while the rotation is switched off below. An explicit template
+// instantiation is exempt from access checks, which is the standard-conforming
+// way to take a pointer to a private member.
+using UpdateMatrixFn = void (Monitor::CMonitor::*)();
+UpdateMatrixFn monitorUpdateMatrix();
+template <UpdateMatrixFn FN> struct SUpdateMatrixAccess {
+  friend UpdateMatrixFn monitorUpdateMatrix() { return FN; }
+};
+template struct SUpdateMatrixAccess<&Monitor::CMonitor::updateMatrix>;
+
+// Offscreen captures (window tiles, the background) are drawn back onto the
+// monitor as ordinary textures, and drawing a texture already applies the
+// monitor's rotation. Capturing with the rotation on as well turns the content
+// sideways and squeezes it into the wrong aspect ratio, so on a rotated
+// monitor each capture is taken as if the monitor were unrotated, at its
+// logical (transformed) size. Restored when the guard goes out of scope.
+struct SUnrotatedCapture {
+  PHLMONITOR mon;
+  wl_output_transform transform;
+  Vector2D pixelSize;
+  explicit SUnrotatedCapture(PHLMONITOR m)
+      : mon(m), transform(m->m_transform), pixelSize(m->m_pixelSize) {
+    if (transform == WL_OUTPUT_TRANSFORM_NORMAL)
+      return;
+    mon->m_transform = WL_OUTPUT_TRANSFORM_NORMAL;
+    mon->m_pixelSize = mon->m_transformedSize;
+    (mon.get()->*monitorUpdateMatrix())();
+  }
+  ~SUnrotatedCapture() {
+    if (transform == WL_OUTPUT_TRANSFORM_NORMAL)
+      return;
+    mon->m_transform = transform;
+    mon->m_pixelSize = pixelSize;
+    (mon.get()->*monitorUpdateMatrix())();
+  }
+};
