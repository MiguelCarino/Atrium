+void hyprviewStepWorkspace(PHLMONITOR monitor, int direction) {
+  // A wheel notch can arrive as several events (high-resolution wheels,
+  // touchpads), so steps are rate-limited to one per 200 ms.
+  static auto lastStep = std::chrono::steady_clock::time_point{};
+  const auto now = std::chrono::steady_clock::now();
+  if (now - lastStep < std::chrono::milliseconds(200))
+    return;
+  lastStep = now;
+
+  // The axis event is still being dispatched to the instance that is about to
+  // be destroyed, so the rebuild runs on the next event loop iteration.
+  g_pEventLoopManager->doLater([weak = PHLMONITORREF{monitor}, direction] {
+    auto mon = weak.lock();
+    if (!mon || g_unloading)
+      return;
+    auto it = g_pHyprViewInstances.find(mon);
+    if (it == g_pHyprViewInstances.end() || !it->second ||
+        it->second->closing || it->second->m_isSwiping)
+      return;
+
+    // This monitor's regular workspaces in id order; the step does not wrap.
+    std::vector<PHLWORKSPACE> workspaces;
+    for (const auto &ref : State::workspaceState()->workspaces()) {
+      auto ws = ref.lock();
+      if (ws && !ws->inert() && !ws->m_isSpecialWorkspace &&
+          ws->m_monitor.lock() == mon)
+        workspaces.push_back(ws);
+    }
+    std::ranges::sort(workspaces, {}, [](const PHLWORKSPACE &ws) { return ws->m_id; });
+    auto cur = std::ranges::find(workspaces, mon->m_activeWorkspace);
+    if (cur == workspaces.end())
+      return;
+    const auto idx = (cur - workspaces.begin()) + direction;
+    if (idx < 0 || idx >= (long)workspaces.size())
+      return;
+    const auto target = workspaces[idx];
+
+    const auto mode = it->second->collectionMode();
+    const auto placement = it->second->placement();
+
+    // Same teardown as the 'off' dispatcher, minus the closing animation: the
+    // destructor puts every window back on its own workspace.
+    g_pHyprRenderer->m_renderPass.removeAllOfType("CHyprViewPassElement");
+    g_pHyprViewInstances.erase(it);
+
+    const auto previous = mon->m_activeWorkspace;
+    mon->changeWorkspace(target, false, true);
+    // Hyprland's own workspace slide would still be running while the new
+    // overview captures its tiles, smearing them; the overview slides instead.
+    for (const auto &ws : {previous, target}) {
+      if (!ws)
+        continue;
+      ws->m_renderOffset->warp();
+      ws->m_alpha->warp();
+    }
+
+    renderingOverview = true;
+    auto view = std::make_unique<CHyprView>(mon, mon->m_activeWorkspace, false,
+                                            mode, placement);
+    view->slideIn(direction);
+    g_pHyprViewInstances[mon] = std::move(view);
+    renderingOverview = false;
+  });
+}
