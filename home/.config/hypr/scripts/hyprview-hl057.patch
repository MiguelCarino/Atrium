diff --git a/src/compat057.hpp b/src/compat057.hpp
new file mode 100644
index 0000000..387b393
--- /dev/null
+++ b/src/compat057.hpp
@@ -0,0 +1,48 @@
+#pragma once
+
+// Hyprland 0.57 (applied by scripts/hyprview-hl057.patch, only when building
+// against 0.57 headers):
+//   - desktop/view/Window.hpp moved to desktop/view/window/Window.hpp; a
+//     window's title and class live in metadata()
+//   - CWorkspace became Workspace::CHLWorkspace: the id is a variant
+//     (numbered or special) behind id()/numberedID(), m_isSpecialWorkspace is
+//     type(), and inert() is gone (the state tracker only lists live ones)
+//   - managers/KeybindManager.hpp is gone; modifier strings are parsed by
+//     Keybinds::modMaskFromString (keybinds/Resolver.hpp)
+//   - every draw takes a Render::CRenderContext (renderer->context() during a
+//     fake render, the pass element's argument while drawing)
+
+#include <hyprland/src/desktop/view/window/Window.hpp>
+#include <hyprland/src/workspace/HLWorkspace.hpp>
+#include <hyprland/src/keybinds/Resolver.hpp>
+#include <hyprland/src/render/Context.hpp>
+
+#include <limits>
+
+namespace hyprview_compat {
+    inline bool isSpecial(const PHLWORKSPACE& ws) {
+        return ws && ws->type() == Workspace::eWorkspaceType::SPECIAL;
+    }
+
+    // Numbered workspaces in id order; named and special ones after them.
+    inline int64_t sortKey(const PHLWORKSPACE& ws) {
+        if (!ws)
+            return std::numeric_limits<int64_t>::max();
+        if (const auto id = ws->numberedID())
+            return *id;
+        return std::numeric_limits<int64_t>::max() - 1;
+    }
+
+    // What the tiles show: the number, or the name for a named/special one.
+    inline std::string label(const PHLWORKSPACE& ws) {
+        if (!ws)
+            return "?";
+        if (const auto id = ws->numberedID())
+            return std::to_string(*id);
+        return ws->addressableName();
+    }
+
+    inline const std::string& title(const PHLWINDOW& w) {
+        return w->metadata().title();
+    }
+}
