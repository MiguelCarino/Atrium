# Recolours waybar's workspace pills by the monitor each workspace is on:
# ~/.config/waybar/scripts/workspace-tint.py
[Unit]
Description=Waybar workspace pill tint
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "Hyprland" ""
ExecStart=/usr/bin/python3 %h/.config/waybar/scripts/workspace-tint.py watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
