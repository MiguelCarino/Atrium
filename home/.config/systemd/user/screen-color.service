# Brightness / colour per screen and the night light's warmth, one colour
# matrix per screen: ~/.config/hypr/scripts/screen-color.py (replaces hyprsunset).
[Unit]
Description=Per-screen brightness and colour (Hyprland CTM)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "Hyprland" ""
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/screen-color.py daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
