# Safe mode for the Hyprland config: ~/.config/hypr/scripts/hypr-guard.py
[Unit]
Description=Keep the last working Hyprland config, restore it on errors
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "Hyprland" ""
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/hypr-guard.py daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
