# Emergency alerts (earthquake early warning, tsunami, severe weather, civil
# protection) for where you live: ~/.config/hypr/scripts/emergency-alerts.py
# -- a backup to the official sirens, radio and phone alerts.
[Unit]
Description=Emergency alerts on the desktop (backup to official channels)
PartOf=graphical-session.target
After=graphical-session.target network-online.target

[Service]
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "Hyprland" ""
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/emergency-alerts.py daemon
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
