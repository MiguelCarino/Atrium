# Every 3 minutes while the desktop is up: sessions-autosave.service.
[Unit]
Description=Save the open windows every few minutes (where was I)
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=2min
OnUnitActiveSec=3min
AccuracySec=30s
RandomizedDelaySec=20s

[Install]
WantedBy=graphical-session.target
