# ~/.config/themes/seasons/season/spring/mako -- the spring colours of the
# seasons theme's notifications. theme.py merges it with ../../mako
# (mako_merge: the theme's global lines, these global lines, the theme's
# sections, these sections), so a line here beats the theme's same line and
# a global line here cannot land inside the theme's [urgency=low]. Colours
# only: the face, borders, radius and padding are ../../mako's, the same all
# year. mako colours are #RRGGBBAA, unquoted.
#
# The card is the spring card #141c17 at F2 (95%; mako draws no blur): over a
# dark window #131b16, over a white one #202823, the worst case.
# Contrast, WCAG, dark / white behind: text #eee2e8 13.9 / 12.0, the
# low-urgency dim #a9b8ad 8.5 / 7.3. The hairline #46604f (2.5 / 2.2)
# is decoration; the critical border, the spring bad #ff6a45 6.2 / 5.3, is the
# signal and clears 3:1. The progress bar is the accent #f4a8d0 at 1/3 over
# the card.
background-color=#141C17F2
text-color=#EEE2E8
border-color=#46604F
progress-color=over #F4A8D055

[urgency=critical]
# text-color again: mako/sections paints a critical body in its neon pink,
# which only this line replaces -- urgency is the frame, not a red paragraph.
# (Inside the section: mako_merge cuts at the first "[" line, so a comment
# above it would travel with the global lines.)
border-color=#FF6A45
text-color=#EEE2E8

[urgency=low]
text-color=#A9B8AD
border-color=#2C3D32
