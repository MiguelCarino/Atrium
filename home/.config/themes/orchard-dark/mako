# ~/.config/themes/orchard-dark/mako -- mako fragment for the orchard-dark
# theme, copied to ~/.config/mako/generated/theme by theme.py and included
# LAST by ~/.config/mako/config (global lines first, then the sections it
# repeats). accent_follow=no, so no accent include is added after these lines.
#
# orchard's notification card in the dark appearance -- the same shape,
# lines and placement (orchard/mako explains them: top-right under the menu
# bar, 372 px wide, 16 px corners, a hairline, the icon at 36 px on the
# left, the app's name small and grey over the bold title and the body; the
# anchor stays Settings > Notifications' choice). A translucent graphite
# card (#2a2a2c at 92%, frosted by the `notifications` layer blur in
# lua/rules.lua; mako draws no shadow of its own) with a faint white
# hairline, as dark-mode cards have.
#
# Contrast (WCAG), on the card (#2a2a2c; dark): text #f5f5f7 13.2:1, the app
# line (62% of it) 6.0:1, the low-urgency body #a1a1a6 5.6:1. Critical: a
# 1px red hairline (#ff453a) -- its timeout stays Settings' (0 by default);
# the text keeps its colours (urgency is the frame, not a red paragraph).
font=Inter, Adwaita Sans, IBM Plex Sans 10.5
background-color=#2A2A2CEB
text-color=#F5F5F7
border-color=#FFFFFF1A
border-size=1
border-radius=16
progress-color=over #0A84FF66
width=372
height=200
margin=8
outer-margin=46,12,12,12
padding=12,14
icons=1
max-icon-size=36
icon-location=left
# "%%" is a literal percent: mako reads every "%" in format= as a specifier,
# and a bare "62%" makes it reject the WHOLE config (mako then keeps the
# previous theme's look and `makoctl reload` fails).
format=<span size="small" alpha="62%%">%a</span>\n<b>%s</b>\n%b

# Sections from ~/.config/mako/sections, recoloured.
[grouped]
format=<span size="small" alpha="62%%">%a  (%g)</span>\n<b>%s</b>\n%b

[urgency=critical]
border-color=#FF453A
border-size=1
text-color=#F5F5F7
format=<span size="small" alpha="62%%">%a</span>\n<b>%s</b>\n%b

[urgency=low]
text-color=#A1A1A6
