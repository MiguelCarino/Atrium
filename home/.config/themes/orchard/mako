# ~/.config/themes/orchard/mako -- mako fragment for the orchard theme, copied
# to ~/.config/mako/generated/theme by theme.py and included LAST by
# ~/.config/mako/config (global lines first, then the sections it repeats).
# accent_follow=no, so no accent include is added after these lines.
#
# A notification is the system's notification card: top-right under the
# menu bar (the anchor is Settings > Notifications' choice -- behaviour, in
# generated/settings -- top-right by default; this file sets looks only),
# a translucent light card (#c4c4ca at 92%, frosted by the `notifications`
# layer blur in lua/rules.lua -- mako draws no shadow of its own), 16px
# corners, a hairline round it, the app's icon at 36px on the left, and
# three lines: the app's name small and grey, the title bold, the body.
# 372 px wide, 12/14 px inside; the stack starts 46 px down (the 38 px bar
# plus 8) and 12 px in from the edge.
#
# Inter regular: theme.py writes the stack in SemiBold above these lines;
# the body here is regular (the title is bold through its <b> markup), as
# the real cards are. mako has one font size: 10.5pt ~ 14px.
#
# Contrast (WCAG), on the card (#c4c4ca over a mid backdrop; luminance
# 0.55, a small field): text #1d1d1f 9.7:1, the app line (62% ink, about
# #5c5c60) 3.8:1, the low-urgency body #4f4f54 4.7:1. Critical: a 1px red
# hairline (#d70015) -- its timeout stays Settings' (0 by default); the
# text keeps its colours (urgency is the frame, not a red paragraph).
font=Inter, Adwaita Sans, IBM Plex Sans 10.5
background-color=#C4C4CAEB
text-color=#1D1D1F
border-color=#0000001F
border-size=1
border-radius=16
progress-color=over #0062CC66
width=372
height=200
margin=8
outer-margin=46,12,12,12
padding=12,14
icons=1
max-icon-size=36
icon-location=left
# "%%" is a literal percent: mako reads every "%" in format= as a specifier,
# and a bare "62%" makes it reject the WHOLE config (mako then keeps the
# previous theme's look and `makoctl reload` fails).
format=<span size="small" alpha="62%%">%a</span>\n<b>%s</b>\n%b

# Sections from ~/.config/mako/sections, recoloured.
[grouped]
format=<span size="small" alpha="62%%">%a  (%g)</span>\n<b>%s</b>\n%b

[urgency=critical]
border-color=#D70015
border-size=1
text-color=#1D1D1F
format=<span size="small" alpha="62%%">%a</span>\n<b>%s</b>\n%b

[urgency=low]
text-color=#4F4F54
